# Fill in the keys you have. Providers with an empty key are skipped.
# Keyless providers are off until you set their variable to 1.

# Google AI Studio: https://aistudio.google.com/app/apikey
#   Separate quota per model
GEMINI_API_KEY=

# NVIDIA NIM: https://build.nvidia.com
#   ~40 requests/min across all models
NVIDIA_API_KEY=

# Groq: https://console.groq.com/keys
#   Fastest; 8K tokens/min per model
GROQ_API_KEY=

# Cloudflare Workers AI: https://dash.cloudflare.com/profile/api-tokens
#   10,000 neurons/day shared
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Mistral: https://console.mistral.ai/api-keys
#   2 requests/min, big monthly budget
MISTRAL_API_KEY=

# Z.ai (GLM): https://z.ai
#   GLM Flash models free, ~1M tokens/day
ZAI_API_KEY=

# Ollama Cloud: https://ollama.com/settings/keys
#   Light weekly GPU-time allowance
OLLAMA_API_KEY=

# Cohere: https://dashboard.cohere.com/api-keys
#   Trial key: ~33 requests/day per model
COHERE_API_KEY=

# LLM7.io: https://token.llm7.io
#   40 requests/min, ~1M tokens/day
LLM7_API_KEY=

# xKiro [third-party gateway]: https://xkiro.com
#   Third-party gateway: 500K tokens/day
XKIRO_API_KEY=

# ElectronHub [third-party gateway]: https://electronhub.ai
#   Third-party gateway: $0.25/week credit
ELECTRONHUB_API_KEY=

# NaraRouter [third-party gateway]: https://bynara.id
#   Third-party gateway: 7M tokens/day, Telegram verification
NARA_API_KEY=

# Requesty [third-party gateway]: https://requesty.ai
#   Third-party router: 200 requests/day shared
REQUESTY_API_KEY=

# BazaarLink [third-party gateway]: https://bazaarlink.ai
#   Third-party gateway: 50 requests/day
BAZAARLINK_API_KEY=

# UnoRouter [third-party gateway]: https://unorouter.com
#   Third-party gateway: 1 request/min per model
UNOROUTER_API_KEY=

# AMD Radeon Cloud [third-party gateway]: https://developer.amd.com.cn
#   China-hosted; daily allowance
RADEON_API_KEY=

# Agnes AI [third-party gateway]: https://agnes-ai.com
#   Promotional $0 models
AGNES_API_KEY=

# Routeway [third-party gateway]: https://routeway.ai
#   Third-party: ~5 requests/min, 200/day
ROUTEWAY_API_KEY=

# Pollinations [third-party gateway]: https://enter.pollinations.ai/keys
#   Spends free Quest Pollen; use the sk_ (secret) key
POLLINATIONS_API_KEY=

# OpenRouter: https://openrouter.ai/settings/keys
#   50 requests/day shared by all free models
OPENROUTER_API_KEY=

# Kilo Gateway (no key) [third-party gateway]: https://kilo.ai
#   No key. 200 requests/hour per IP; prompts logged for training
KILO_ENABLED=

# OVHcloud (no key): https://endpoints.ai.cloud.ovh.net
#   No key. 2 requests/min per model
OVH_ENABLED=

# Aion Labs: https://aionlabs.ai
#   20K tokens/day; no tool calling
AION_API_KEY=

# SEA-LION: https://sea-lion.ai
#   10 requests/min; no tool calling
SEALION_API_KEY=

# Hugging Face Router: https://huggingface.co/settings/tokens
#   $0.10/month credit
HF_TOKEN=

# AnyAPI [third-party gateway]: https://anyapi.ai
#   Third-party: 100K tokens/day on free models
ANYAPI_API_KEY=

# NavyAI [third-party gateway]: https://api.navy
#   Third-party: 150K tokens/day, 20 requests/min
NAVY_API_KEY=

# OrcaRouter [third-party gateway]: https://orcarouter.ai
#   Third-party: free aliases, unpublished limits
ORCAROUTER_API_KEY=

# LongCat (Meituan): https://longcat.chat
#   Free quota after signup + KYC
LONGCAT_API_KEY=

# Experiential Labs [third-party gateway]: https://www.experientiallabs.ai
#   Third-party: ~$5/month shared credit
EXPERIENTIAL_API_KEY=

# DeepSeek (one-time credit): https://platform.deepseek.com/api_keys
#   5M tokens once, expire after 30 days
DEEPSEEK_API_KEY=

# Cerebras (one-time credit): https://cloud.cerebras.ai
#   $5 once, card required, 30 days
CEREBRAS_API_KEY=
